@@ -0,0 +1,21 @@
+"""Observe nested 8/16-bit C calls in KUROSAKI, including live argument slots."""
+import json,os,subprocess,tempfile,unittest
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+class FcCallTempsTests(unittest.TestCase):
+    def test_nested_calls_preserve_live_expression_values(self):
+        compiler=Path(os.environ.get('KITAQFC_EXE',ROOT/'kitaqfc/kitaqfc.exe'))
+        kurosaki=Path(os.environ.get('KUROSAKI_EXE',ROOT/'kurosaki/target/release/kurosaki.exe'))
+        self.assertTrue(compiler.exists(),str(compiler));self.assertTrue(kurosaki.exists(),str(kurosaki))
+        expected=[42,6,0x1436,0x600,35,39,7,1,1,0xA55A,0xFFF9,1]
+        for opt in ['-O0','-O1']:
+            with self.subTest(optimization=opt),tempfile.TemporaryDirectory() as tmp:
+                out=Path(tmp);rom=out/'test.nes';state=out/'state.json'
+                p=subprocess.run([str(compiler),str(ROOT/'tests/fixtures/fc_call_temps.c'),'-o',str(rom),'--mapper=nrom','--no-disasm',opt],cwd=out,capture_output=True,timeout=60)
+                self.assertEqual(p.returncode,0,(p.stdout+p.stderr).decode('utf-8',errors='replace'))
+                p=subprocess.run([str(kurosaki),'snapshot-save',str(rom),'--frames','4','--out',str(state)],cwd=out,capture_output=True,timeout=60)
+                self.assertEqual(p.returncode,0,p.stderr.decode('utf-8',errors='replace'))
+                ram=json.loads(state.read_text(encoding='utf-8'))['bus']['ram']
+                actual=[ram[0x600+2*i] | (ram[0x601+2*i]<<8) for i in range(len(expected))]
+                self.assertEqual(actual,expected)
+if __name__=='__main__':unittest.main()
