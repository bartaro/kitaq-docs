+++ b/tests/test_kitaqgb_jump_label_scope.py
@@ -0,0 +1,32 @@
+"""A reused loop_end_1 must resolve inside its own function during JP->JR."""
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT));sys.path.insert(0,str(ROOT/'kokura/python'))
+from kitaqgb_py import compile_rom,resolve_kitaqgb_executable
+from kokura_bridge import Core,KokuraLibrary
+
+class JumpLabelScopeTests(unittest.TestCase):
+    def test_entity_full_pool_and_reuse_in_both_optimization_modes(self):
+        dll=ROOT/'kokura/target/debug/kokura_capi.dll'
+        self.assertTrue(dll.exists(), 'Runtime regression requires the KOKURA C API')
+        dll_dir=os.add_dll_directory(str(dll.parent)) if hasattr(os,'add_dll_directory') else None
+        try:
+            kokura=KokuraLibrary(str(dll))
+            for optimization in ('-O0','-O1'):
+                with self.subTest(optimization=optimization),tempfile.TemporaryDirectory() as tmp:
+                    rom=Path(tmp)/'scope.gb'
+                    result=compile_rom([ROOT/'kitaqgb/lib/entity.c',ROOT/'tests/fixtures/entity_label_scope.c'],rom,
+                        executable=resolve_kitaqgb_executable(),working_directory=Path(tmp),raise_on_error=False,
+                        extra_args=['-I',str(ROOT/'lib'),'--rst-disable','--no-cache','--no-disasm','--stack-bank=fixed',optimization])
+                    self.assertTrue(result.success,result.stderr)
+                    with Core(kokura) as core:
+                        core.load_rom_path(rom);core.run_frames(4)
+                        self.assertEqual(core.read_block(0xC500,8),bytes([0,16,255,42,15,0,255,0xA5]))
+        finally:
+            if dll_dir:dll_dir.close()
+
+if __name__=='__main__':unittest.main()
